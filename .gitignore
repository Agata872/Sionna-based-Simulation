# Python 虚拟环境（约 6.7 GB，用 requirements.txt 复现）
.venv

# Python 缓存
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# 仿真输出
results/

# 参考资料（版权文档，不纳入 git）
*.pdf

# IDE 配置（PyCharm）
.idea/

