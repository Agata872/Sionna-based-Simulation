studies/twin_ci_compression/paper1/manuscript/*.aux
studies/twin_ci_compression/paper1/manuscript/*.bbl
studies/twin_ci_compression/paper1/manuscript/*.blg
studies/twin_ci_compression/paper1/manuscript/*.fdb_latexmk
studies/twin_ci_compression/paper1/manuscript/*.fls
studies/twin_ci_compression/paper1/manuscript/*.log
studies/twin_ci_compression/paper1/manuscript/*.out
studies/twin_ci_compression/paper1/manuscript/*.synctex.gz
